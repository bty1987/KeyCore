(module Button_Switch_TS-1187A (layer F.Cu) (tedit 6510A001)
  (descr "TS-1187A 6x6mm SMD tact switch, 4 pads at (±2.6, ±1.4) per datasheet recommended land pattern")
  (tags "tact switch 6x6 TS-1187A")
  (attr smd)
  (fp_text reference REF** (at 0 -4.2) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value TS-1187A (at 0 4.2) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -3 -3) (end 3 -3) (layer F.Fab) (width 0.1))
  (fp_line (start 3 -3) (end 3 3) (layer F.Fab) (width 0.1))
  (fp_line (start 3 3) (end -3 3) (layer F.Fab) (width 0.1))
  (fp_line (start -3 3) (end -3 -3) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 1.7 0) (layer F.Fab) (width 0.1))
  (fp_line (start -3.9 -2.6) (end -3.9 2.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.9 2.6) (end 3.9 2.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.9 2.6) (end 3.9 -2.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.9 -2.6) (end -3.9 -2.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.6 -2.2) (end -3.6 2.2) (layer F.SilkS) (width 0.12))
  (fp_line (start 3.6 -2.2) (end 3.6 2.2) (layer F.SilkS) (width 0.12))
  (pad 1 smd rect (at -2.6 -1.4) (size 1.6 1) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -2.6 1.4) (size 1.6 1) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 2.6 -1.4) (size 1.6 1) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at 2.6 1.4) (size 1.6 1) (layers F.Cu F.Paste F.Mask))
)
