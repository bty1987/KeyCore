// ============================================================
// 厚板通孔方案 v4 · 2026-10-07 重生成（取代 thickplate-v3.scad，旧文件已删）
//   板 = 300.2×192×9（与 PCB 同高同宽，四角 R4）；67 孔【打穿】（2026-10-04 用户拍板）
//   孔心 = EDA 霍尔位 H01~H67 直接映射（用户 2026-10-07 拍板：v5.1"+4 预放偏置"弃用，霍尔位即键位）
//   磁道 73 条 = 键帽缝道 61（自前缘 y=0 即空格侧板缘开通至缝位，磁铁 4×2 竖放水平插入）
//               + 行端道 12（自左右板缘开通）；剖面 z 3~7，边缘开口盲槽【不穿透】→ 工艺 CNC
//   坐标系：scad = EDA 帧直接映射（x 相同；y_scad = 192 + EDA_y_mm = 距前缘距离，y-up）
//   订购图：07-PCB/output/厚板订购图-V6-打穿版-20261007.svg（与本文件同源同值）
// 磁路 v5.2（与 pcb-hall-positions.csv 键宽列同源）：
//   每键 2×N52 4×2 圆盘【竖立】嵌键帽左右侧壁——外侧壁水平打腔横插，N 面朝邻键缝隙
//     1u：±7.025；宽键：±(wu×9.525−2.0−wall_t)（外壁 0.5，极面间隙≈3.0mm）
// ★ P0′ 待裁决（不变）：① 竖立磁铁感应点位实测扫偏 ② 帽间对斥无托举→PCB 平贴对斥磁是否加
// ============================================================

// ---- 板 ----
plate_w = 300.2;
plate_d = 192.0;
plate_t = 9.0;         // 厚板厚
hole_sq = 17.6;        // 键孔边长（1u 块 17.05 + 0.6 公差；宽键孔随 wu 加宽）
hole_r  = 2.0;         // 孔角 R
// ---- 键帽块（P3 另做，悬浮于通孔内，加长 11）----
key_wu   = 1;                        // 键宽 u（-D key_wu=1.5/1.75/2/2.25/2.75/6.25）
cap_w    = key_wu*19.05 - 2.0;       // 块宽（1u=17.05，直壁防邻键干涉）
cap_d    = 17.0;                     // 块深
cap_h    = 7.5;                      // 块高
cap_top_r = 2.0;                     // 顶面圆角
// ---- 侧磁（v5.3 全竖立+贴缝版）----
mag_d   = 4.1;         // 4×2 磁铁腔（+0.1 公差）
mag_z   = 2.05;        // 竖立腔轴心高（腔 Ø4.1 竖跨块底 0~4.1）
wall_t  = 0.5;         // 极面外壁（★间距旋钮：极面间隙≈2.05+2×wall_t）
mag_off = key_wu*9.525 - 2.0 - wall_t;   // 磁心横偏（1u=7.025；宽键同步）
echo(str("键帽块 ", key_wu, "u：", cap_w, "×", cap_d, "×", cap_h, "，孔宽 ", cap_w+0.6,
         "，侧磁 ±", mag_off, "（外壁 ", cap_w/2 - mag_off - mag_d/2, "mm）"));
echo(str("极面间隙 = ", 19.05 - cap_w + 2*wall_t, "mm（目标 ≥2，越小斥力越强）"));

// ---- 67 孔坐标（EDA live 霍尔位 2026-10-07；x,y=孔心（=霍尔位），wu=键宽；生成器注入勿手改）----
frame_holes = [[16.523, 92.488, 1], [35.573, 92.488, 1], [54.623, 92.488, 1], [73.673, 92.488, 1], [92.723, 92.488, 1], [111.773, 92.488, 1], [130.823, 92.488, 1], [149.873, 92.488, 1], [168.923, 92.488, 1], [187.973, 92.488, 1], [207.023, 92.488, 1], [226.073, 92.488, 1], [245.123, 92.488, 1], [273.698, 92.488, 2], [21.285, 73.438, 1.5], [45.098, 73.438, 1], [64.148, 73.438, 1], [83.198, 73.438, 1], [102.248, 73.438, 1], [121.298, 73.438, 1], [140.348, 73.438, 1], [159.398, 73.438, 1], [178.448, 73.438, 1], [197.498, 73.438, 1], [216.548, 73.438, 1], [235.598, 73.438, 1], [254.648, 73.438, 1], [278.46, 73.438, 1.5], [23.668, 54.388, 1.75], [49.86, 54.388, 1], [68.91, 54.388, 1], [87.96, 54.388, 1], [107.01, 54.388, 1], [126.06, 54.388, 1], [145.11, 54.388, 1], [164.16, 54.388, 1], [183.21, 54.388, 1], [202.26, 54.388, 1], [221.31, 54.388, 1], [240.36, 54.388, 1], [271.318, 54.388, 2.25], [28.43, 35.338, 2.25], [59.385, 35.338, 1], [78.435, 35.338, 1], [97.485, 35.338, 1], [116.535, 35.338, 1], [135.585, 35.338, 1], [154.635, 35.338, 1], [173.685, 35.338, 1], [192.735, 35.338, 1], [211.785, 35.338, 1], [230.835, 35.338, 1], [266.555, 35.338, 2.75], [18.905, 16.288, 1.25], [42.718, 16.288, 1.25], [66.53, 16.288, 1.25], [137.968, 16.288, 6.25], [209.405, 16.288, 1.25], [233.218, 16.288, 1.25], [257.03, 16.288, 1.25], [280.843, 16.288, 1.25], [16.523, 111.538, 1], [35.573, 111.538, 1], [54.623, 111.538, 1], [73.673, 111.538, 1], [92.723, 111.538, 1], [111.773, 111.538, 1]];

// 行心 y（行端道用；生成器注入勿手改）
row_ys = [111.538, 92.488, 73.438, 54.388, 35.338, 16.288];

// 打穿键孔（方孔 R2，宽随 wu）
module through_hole(x, y, wu) {
  hw = wu*19.05 - 2.0 + 0.6;   // 孔宽 = 块宽 + 0.6 公差
  translate([x, y, -0.1])
    linear_extrude(plate_t + 0.2)
      hull() for (sx=[-1,1], sy=[-1,1])
        translate([sx*(hw/2-hole_r), sy*(hole_sq/2-hole_r)]) circle(r=hole_r, $fn=48);
}
module all_holes() for (p = frame_holes) through_hole(p[0], p[1], p[2]);

// 键帽块（顶圆角，左右侧壁水平竖立腔：磁铁完全嵌入帽内部，同排全部同向）——P3 键帽件用
module keycap_block() {
  difference() {
    union() {
      linear_extrude(cap_h - 1.0) offset(r=1.2) square([cap_w, cap_d], center=true);
      translate([0,0,cap_h-1.0]) linear_extrude(1.0)
        hull() for (sx=[-1,1], sy=[-1,1])
          translate([sx*(cap_w/2-cap_top_r), sy*(cap_d/2-cap_top_r)]) circle(r=cap_top_r, $fn=32);
    }
    for (s=[-1,1])
      translate([s*cap_w/2, 0, mag_z])
        rotate([0, -s*90, 0])
          cylinder(d=mag_d, h=cap_w/2 - mag_off + 1.1, $fn=40);
  }
}

// 缝道 ×61：自前缘 y=0（空格侧板缘）沿缝位开通至每条键帽缝，2.0 宽 × 4.0 高（z 3~7）
// 磁铁 4×2 竖放、从板前缘插入推至缝位（铁律：磁铁一律竖放）
module seam_channels() {
  for (i = [0 : len(frame_holes) - 2]) {
    a = frame_holes[i]; b = frame_holes[i + 1];
    if (a[1] == b[1]) {                      // 同一排才构成键帽缝
      hwa = a[2]*19.05 - 2 + 0.6; hwb = b[2]*19.05 - 2 + 0.6;
      sx = (a[0] + hwa/2 + b[0] - hwb/2) / 2;  // 缝中央 = 两孔相邻边中点
      translate([sx, a[1]/2, 5.0])
        cube([2.0, a[1] + 2, 4.0], center = true);   // y −1 → 缝心+1（缘外 1mm 为切削余量）
    }
  }
}

// 行端道 ×12：端键磁心对齐外推，左端自左缘、右端自右缘水平开通，4.0 × 4.0（z 3~7）
module end_channels() {
  for (y = row_ys) {
    row = [for (p = frame_holes) if (p[1] == y) p];
    a = row[0]; b = row[len(row) - 1];
    sxL = a[0] - a[2]*9.525;   // 左端槽心（磁心再外推 2.5，与 v3 同式）
    sxR = b[0] + b[2]*9.525;
    translate([(-1 + sxL + 1.0) / 2, y, 5.0])
      cube([sxL + 2.0, 4.0, 4.0], center = true);          // 左通道: x −1 → 槽心+1
    translate([(sxR - 1.0 + plate_w + 1) / 2, y, 5.0])
      cube([plate_w + 1 - sxR + 1.0, 4.0, 4.0], center = true);  // 右通道: 槽心−1 → 板右缘外
  }
}

// 厚板本体（300.2×192 四角 R4；挖 67 打穿孔 + 61 缝道 + 12 行端道）
module thick_plate() {
  difference() {
    translate([4, 4, 0]) linear_extrude(plate_t)
      offset(r=4) square([plate_w-8, plate_d-8]);
    all_holes();
    seam_channels();
    end_channels();
  }
}

// P3 试装板：1u×2 + 2u×1 单排（试产帽手感/摇晃量/回弹实测）
module test_plate() {
  difference() {
    translate([3, 3, 0]) linear_extrude(plate_t) offset(r=3) square([100, 40]);
    for (p = [[14, 20, 1], [33.05, 20, 1], [70, 20, 2]])
      through_hole(p[0], p[1], p[2]);
  }
}

thick_plate();   // 默认出厚板；试装板用 test_plate() 手动替换
