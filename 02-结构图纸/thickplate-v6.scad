mag_positions = [[7.0, 16.288], [30.81, 16.288], [54.62, 16.288], [78.44, 16.288], [197.5, 16.288], [221.31, 16.288], [245.12, 16.288], [268.94, 16.288], [292.75, 16.288], [7.0, 35.338], [49.86, 35.338], [68.91, 35.338], [87.96, 35.338], [107.01, 35.338], [126.06, 35.338], [145.11, 35.338], [164.16, 35.338], [183.21, 35.338], [202.26, 35.338], [221.31, 35.338], [240.36, 35.338], [292.75, 35.338], [7.0, 54.388], [40.34, 54.388], [59.38, 54.388], [78.43, 54.388], [97.48, 54.388], [116.53, 54.388], [135.59, 54.388], [154.64, 54.388], [173.69, 54.388], [192.74, 54.388], [211.78, 54.388], [230.84, 54.388], [249.89, 54.388], [292.75, 54.388], [7.0, 73.438], [35.57, 73.438], [54.62, 73.438], [73.67, 73.438], [92.72, 73.438], [111.77, 73.438], [130.82, 73.438], [149.87, 73.438], [168.92, 73.438], [187.97, 73.438], [207.02, 73.438], [226.07, 73.438], [245.12, 73.438], [264.17, 73.438], [292.75, 73.438], [7.0, 92.488], [26.05, 92.488], [45.1, 92.488], [64.15, 92.488], [83.2, 92.488], [102.25, 92.488], [121.3, 92.488], [140.35, 92.488], [159.4, 92.488], [178.45, 92.488], [197.5, 92.488], [216.55, 92.488], [235.6, 92.488], [254.65, 92.488], [292.75, 92.488], [7.0, 111.538], [26.05, 111.538], [45.1, 111.538], [64.15, 111.538], [83.2, 111.538], [102.25, 111.538], [121.3, 111.538]];
pocket_x = 2.2;
pocket_y = 4.2;
pocket_d = 4.0;

module through_hole(x, y, wu) {
  hw = wu*19.05 - 2.0 + 0.6;
  translate([x, y, -0.1])
    linear_extrude(plate_t + 0.2)
      hull() for (sx=[-1,1], sy=[-1,1])
        translate([sx*(hw/2-hole_r), sy*(hw/2-hole_r)]) circle(r=hole_r, $fn=48);
}
module all_holes() for (p = frame_holes) through_hole(p[0], p[1], p[2]);

module mag_pockets() {
  for (m = mag_positions)
    translate([m[0] - pocket_x/2, m[1] - pocket_y/2, -0.1])
      linear_extrude(pocket_d + 0.1)
        offset(r = 0.5) square([pocket_x - 1.0, pocket_y - 1.0], center = true);
}

module thick_plate() {
  difference() {
    translate([4, 4, 0]) linear_extrude(plate_t)
      offset(r=4) square([plate_w-8, plate_d-8]);
    all_holes();
    mag_pockets();
  }
}

thick_plate();
