// ============================================================
// 厚板通孔方案 v4 · v3.7 + 67 孔打穿(2026-10-04 用户拍板:键帽块加长悬浮于通孔内,真行程空间;
//   兜底=屏幕上方后加 1~2mm 亚克力薄板。水平磁道 73 条不变。键帽块加长至 11 属键帽件 P3。
//   v3.6: 键帽缝水平磁道(不从板顶铣,从板侧面打孔——前缘水平钻至每缝,
//   取消 10-03"板上无磁铁"口径。全板 61 缝×1 颗;磁轴向沿排还是垂直于排/托浮效果 = P0′ 实测第一项,非定案）
// 取代：v3.1 斜立版 / v3.0 块底磁铁版 / 三段式 / v1.6 穿脖（均已删除）
//
// 结构：314.2×201.4×9mm 透明亚克力单块（激光切割/铣），67 盲孔嵌帽
//   盲孔 17.6² 方孔 R2、深 6.5（不打穿，底 2.5）；键帽块顶露板面 1.0~1.5mm
// 磁路 v5.2（与 pcb-hall-positions.csv 同源）：
//   每键 2×N52 4×2 圆盘【竖立】嵌键帽左右侧壁——外侧壁水平打腔横插，N 面朝邻键缝隙
//     1u：±7.025；宽键：±(wu×9.525−2.0−wall_t)（外壁 0.5，极面间隙≈3.0mm，可调至 2.05~4.05）
//   极性：同侧批量同向插（N 全朝缝），相邻帽 N-N 隔缝对斥 = 侧向居中
// ★ 两件 P0′ 必裁决的事（见 01-方案 §3）：
//   ① 竖立磁铁正下方 B_z≈0 → 霍尔正下方点位作废，P0′ 现场扫出偏位点后重出 CSV
//   ② 帽间竖立对斥只有侧向分量（无托举/回弹）→ 需 PCB 面每键加平贴 4×2 对斥托浮
//      （v1.6 已验证的力学，库存 134+134=268≤300 够；是否加、加几颗 = P0′ 拍板）
// ============================================================

// ---- 板 ----
plate_w = 314.2;
plate_d = 201.4;
plate_t = 9.0;         // 厚板（承盲孔 6.5 + 底 2.5）
hole_sq = 17.6;        // 盲孔方孔边长（1u 块 17.0 + 0.6 公差；宽键孔随 wu 加宽）
hole_r  = 2.0;         // 孔角 R
hole_depth = 6.5;      // 盲孔深（1u 块高 7.5 − 露出 1.0~1.5）
// ---- 键帽块 ----
key_wu   = 1;                        // 键宽 u（-D key_wu=1.5/1.75/2/2.25/2.75/6.25）
cap_w    = key_wu*19.05 - 2.0;       // 块宽（1u=17.05，直壁防邻键干涉）
cap_d    = 17.0;                     // 块深
cap_h    = 7.5;                      // 块高
cap_top_r = 2.0;                     // 顶面圆角
// ---- 侧磁（v5.3 全竖立+贴缝版，用户拍板 2026-10-02）----
mag_d   = 4.1;         // 4×2 磁铁腔（+0.1 公差）
mag_z   = 2.05;        // 竖立腔轴心高（腔 Ø4.1 竖跨块底 0~4.1，底缘与块底平齐）
wall_t  = 0.5;         // 极面外壁（★间距旋钮：极面间隙≈2.05+2×wall_t；0.5→3.0mm，0.25→2.55，0→2.05）
mag_off = key_wu*9.525 - 2.0 - wall_t;   // 磁心横偏（1u=7.025；宽键同步）
// 竖立腔：从块外侧壁水平钻入，磁铁 N 面朝邻键缝隙插入（同侧批量同向，401 胶）
// ★ 兜底阶梯（P0′ 单帽先行）：双磁可行→批量；不行→三磁（+底心 1 颗 N 朝下 + 孔底/PCB 平贴对斥，v1.6 力学）
// ★ 几何事实：孔间壁仅 1.45mm，Ø4 竖立磁铁放不进键间——板侧对斥只能平贴孔底/PCB，无"竖立的板侧磁铁"
// ★ 霍尔：竖立磁铁正下方 B_z≈0，P0′ 扫偏位点位后重出 CSV v5.1
echo(str("键帽块 ", key_wu, "u：", cap_w, "×", cap_d, "×", cap_h,
         "，侧磁 ±", mag_off, "（外壁 ", cap_w/2 - mag_off - mag_d/2, "mm）"));

// ---- 67 孔坐标（v5.2 CSV 同源 +9mm 形态偏移：x,y=键中心，wu=键宽；勿手改）----
frame_holes = [[23.75,101.58,1], [42.80,101.58,1], [61.85,101.58,1], [80.90,101.58,1], [99.95,101.58,1], [119.00,101.58,1], [138.05,101.58,1], [157.10,101.58,1], [176.15,101.58,1], [195.20,101.58,1], [214.25,101.58,1], [233.30,101.58,1], [252.35,101.58,1], [280.93,101.58,2], [28.51,120.62,1.5], [52.33,120.62,1], [71.38,120.62,1], [90.42,120.62,1], [109.47,120.62,1], [128.53,120.62,1], [147.57,120.62,1], [166.62,120.62,1], [185.67,120.62,1], [204.72,120.62,1], [223.78,120.62,1], [242.82,120.62,1], [261.88,120.62,1], [285.69,120.62,1.5], [30.89,139.68,1.75], [57.09,139.68,1], [76.14,139.68,1], [95.19,139.68,1], [114.24,139.68,1], [133.29,139.68,1], [152.34,139.68,1], [171.39,139.68,1], [190.44,139.68,1], [209.49,139.68,1], [228.54,139.68,1], [247.59,139.68,1], [278.54,139.68,2.25], [35.66,158.73,2.25], [66.61,158.73,1], [85.66,158.73,1], [104.71,158.73,1], [123.76,158.73,1], [142.81,158.73,1], [161.86,158.73,1], [180.91,158.73,1], [199.96,158.73,1], [219.01,158.73,1], [238.06,158.73,1], [273.78,158.73,2.75], [26.13,177.78,1.25], [49.94,177.78,1.25], [73.76,177.78,1.25], [145.19,177.78,6.25], [216.63,177.78,1.25], [240.44,177.78,1.25], [264.26,177.78,1.25], [288.07,177.78,1.25], [23.75,82.53,1], [42.80,82.53,1], [61.85,82.53,1], [80.90,82.53,1], [99.95,82.53,1], [119.00,82.53,1]];

// 盲孔（方孔 R 角，宽键孔随 wu 加宽）
module blind_hole(x, y, wu) {
  hw = wu*19.05 - 2.0 + 0.6;   // 孔宽 = 块宽 + 0.6 公差
  translate([x, y, plate_t - hole_depth])
    linear_extrude(hole_depth + 0.1)
      hull() for (sx=[-1,1], sy=[-1,1])
        translate([sx*(hw/2-hole_r), sy*(hole_sq/2-hole_r)]) circle(r=hole_r, $fn=48);
}
module all_holes() for (p = frame_holes) blind_hole(p[0], p[1], p[2]);

// 键帽块（顶圆角，左右侧壁水平竖立腔：磁铁完全嵌入帽内部，同排全部同向）
module keycap_block() {
  difference() {
    union() {
      linear_extrude(cap_h - 1.0) offset(r=1.2) square([cap_w, cap_d], center=true);
      translate([0,0,cap_h-1.0]) linear_extrude(1.0)
        hull() for (sx=[-1,1], sy=[-1,1])
          translate([sx*(cap_w/2-cap_top_r), sy*(cap_d/2-cap_top_r)]) circle(r=cap_top_r, $fn=32);
    }
    for (s=[-1,1])
      translate([s*cap_w/2, 0, mag_z])
        rotate([0, -s*90, 0])
          cylinder(d=mag_d, h=cap_w/2 - mag_off + 1.1, $fn=40);
  }
}
// 极面间距自检：应 ≈2.05+2×wall_t（1u/宽键同式）
echo(str("极面间隙 = ", 19.05 - cap_w + 2*wall_t, "mm（目标 ≥2，越小斥力越强）"));

// P3 试装板：2 孔 1u 块位 + 1 孔 2u 位（试产帽手感/摇晃量/回弹实测）
module test_plate() {
  difference() {
    linear_extrude(plate_t) offset(r=3) square([70, 40], center=false);
    for (p=[[24,20,1],[43.05,20,1],[24,39,2]])
      translate([p[0], p[1], plate_t - hole_depth]) blind_hole(p[0], p[1], p[2]);
  }
}

// v3.5 键帽缝磁铁竖放槽：同行相邻孔之间,缝中央开 2.2×4.2×4.3 竖槽（板顶往下;磁铁竖放,轴向水平）
module seam_pockets() {
  // 水平磁道:自前缘(scad y=201.4,空格侧板缘)沿缝位水平打至每条键帽缝,2.0 宽 × 4.0 高(z 3~7,=磁铁尺寸竖放);4×2 磁铁竖放、从板前缘插入推至缝位(铁律:磁铁一律竖放)
  for (i = [0 : len(frame_holes) - 2]) {
    a = frame_holes[i]; b = frame_holes[i + 1];
    if (a[1] == b[1]) {                      // 同一排才构成键帽缝
      hwa = a[2]*19.05 - 2 + 0.6; hwb = b[2]*19.05 - 2 + 0.6;
      sx = (a[0] + hwa/2 + b[0] - hwb/2) / 2;  // 缝中央 = 两孔相邻边中点
      translate([sx, (201.4 + a[1]) / 2, 5.0])
        cube([2.0, 201.4 + 2 - a[1], 4.0], center = true);
    }
  }
  // 行两端磁槽 ×12:与端键外侧磁心对齐外推 2.5,左端槽自左缘、右端槽自右缘水平开通道
  for (y = [101.58, 120.62, 139.68, 158.73, 177.78, 82.53]) {
    row = [for (p = frame_holes) if (p[1] == y) p];
    a = row[0]; b = row[len(row) - 1];
    offA = a[2]*9.525 - 2.5;  offB = b[2]*9.525 - 2.5;
    sxL = a[0] - offA - 2.5;   // 左端槽心
    sxR = b[0] + offB + 2.5;   // 右端槽心
    translate([(-1 + sxL + 1.0) / 2, y, 5.0])
      cube([sxL + 2.0, 4.0, 4.0], center = true);          // 左通道:自 x=-1 至槽位
    translate([(sxR - 1.0 + plate_w + 1) / 2, y, 5.0])
      cube([plate_w + 1 - sxR + 1.0, 4.0, 4.0], center = true);  // 右通道:自槽位至板右缘外
  }
}

// 厚板本体（挖 67 孔 + 61 缝磁道 + 12 行端磁道）
module thick_plate() {
  difference() {
    linear_extrude(plate_t) offset(r=4)
      square([plate_w-8, plate_d-8], center=false);
    translate([0,0,plate_t-hole_depth-0.05]) all_holes();
    seam_pockets();
  }
}

// ---- 渲染/导出入口（命令行 -D 指定）----
part = "plate"; // [plate, block, test_plate]
if (part == "plate") thick_plate();
if (part == "block") keycap_block();
if (part == "test_plate") test_plate();
